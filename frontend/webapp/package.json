{
  "name": "webapp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.3.3",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.1",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-query-auth": "0.2.0",
    "react-router-dom": "^6.21.1",
    "react-scripts": "^5.0.1",
    "react-styleguidist": "^13.1.1",
    "source-map-explorer": "^2.5.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts --openssl-legacy-provider start",
    "build": "react-scripts build",
    "test:watch": "react-scripts test --watchAll=true",
    "test": "react-scripts test --silent --watchAll=false",
    "eject": "react-scripts eject",
    "styleguide": "styleguidist server",
    "styleguide:build": "styleguidist build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged:fix": "npx lint-staged --quiet --no-stash --concurrent 2",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,scss,md,json}' --config ./.prettierrc",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,css,scss,md,json}": [
      "npm run lint:fix"
    ],
    "src/**": [
      "npm run format"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "globals": "^15.10.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  }
}
