{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "author": "solinvictus",
  "license": "ISC",
  "description": "backend for frontend",
  "type": "module",
  "scripts": {
    "start": "nodemon app.js",
    "dev:server": "npm run build:server:once && npm-run-all --parallel nodemon:prod watch:server",
    "build:server:once": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "watch:server": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
    "nodemon:prod": "cross-env NODE_ENV=development node-dev app.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "lint-staged:fix": "npx lint-staged --no-stash --concurrent 2",
    "format": "prettier --write './**.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc"
  },
  "lint-staged": {
    "**.{js,jsx,ts,tsx,css,scss,md,json}": [
      "npm run lint:fix"
    ],
    "**": [
      "npm run format"
    ]
  },
  "dependencies": {
    "@letstalk/db-service": "file:../db-script",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^9.12.0",
    "babel-loader": "^9.2.1",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "lint-staged": "^15.2.0",
    "node-dev": "^8.0.0",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  }
}
